---
layout: base.njk
pagination:
  data: site.categories
  size: 1
  alias: cat
permalink: "/{{ cat.slug }}/"
pageType: category
eleventyComputed:
  title: "{{ cat.name }}"
  seoTitle: "{{ cat.name }} | Biomuse"
  description: "{{ cat.description }}"
---
<div class="page page--single">
<main class="home">
  <section class="intro">
    <h1>{{ cat.name }}</h1>
    <p>{{ cat.description }}</p>
  </section>

  <ul class="post-list">
    {% for post in collections.articles %}{% if post.data.categorySlug == cat.slug %}
    <li><a href="{{ post.url }}">
      <span class="cat">{{ post.data.category }}</span>
      <span class="t">{{ post.data.title }}</span>
      <span class="d">{{ post.data.standfirst }}</span>
    </a></li>
    {% endif %}{% endfor %}
  </ul>

  <div class="section-head"><h2>Other topics</h2></div>
  <ul class="topic-list">
    {% for c in site.categories %}{% if c.slug != cat.slug %}
    <li><a href="/{{ c.slug }}/"><span class="n">{{ c.name }}</span></a></li>
    {% endif %}{% endfor %}
  </ul>
</main>
</div>
