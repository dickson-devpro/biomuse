;\n    font-weight: 800 !important;\n    letter-spacing: 0.03em !important;\n    text-transform: uppercase !important;\n    cursor: pointer !important;\n    color: #fff !important;\n    background: #8a5a2b !important;\n    text-align: center !important;\n    box-sizing: border-box !important;\n    line-height: 1.3 !important;\n    font-family: inherit !important;\n    transition: transform 0.15s, filter 0.15s !important;\n  }\n  #reward-gate-modal .gate-btn:hover { filter: brightness(1.1) !important; transform: translateY(-1px) !important; }\n\n  /* ── AD DISCLAIMER ── */\n  #gate-ad-disclaimer {\n    font-size: 0.72rem !important;\n    font-weight: 600 !important;\n    color: #9a948a !important;\n    text-align: center !important;\n    margin: 0 0 12px !important;\n    padding: 0 !important;\n    line-height: 1.5 !important;\n  }\n\n  /* ── UNLOCK SCREEN ── */\n  #gate-unlock-title {\n    font-size: 1.3rem !important;\n    font-weight: 900 !important;\n    color: #1a1a1a !important;\n    text-align: center !important;\n    margin: 8px 0 10px !important;\n    padding: 0 !important;\n  }\n  #gate-unlock-sub {\n    font-size: 0.95rem !important;\n    font-weight: 600 !important;\n    color: #4a4a4a !important;\n    text-align: center !important;\n    margin: 0 0 14px !important;\n    line-height: 1.6 !important;\n    padding: 0 !important;\n  }\n  #gate-view-btn {\n    display: block !important;\n    width: 100% !important;\n    padding: 18px 14px !important;\n    background: #1a1a1a !important;\n    color: #fff !important;\n    border: none !important;\n    border-radius: 10px !important;\n    font-size: 0.95rem !important;\n    font-weight: 800 !important;\n    letter-spacing: 0.04em !important;\n    text-transform: uppercase !important;\n    cursor: pointer !important;\n    box-sizing: border-box !important;\n    line-height: 1.4 !important;\n    text-align: center !important;\n    font-family: inherit !important;\n    transition: filter 0.15s, transform 0.15s !important;\n  }\n  #gate-view-btn:hover { filter: brightness(1.3) !important; transform: translateY(-2px) !important; }\n\n  #gate-ad-note {\n    font-size: 0.78rem !important;\n    font-weight: 600 !important;\n    color: #9a948a !important;\n    text-align: center !important;\n    margin-top: 10px !important;\n    padding: 0 !important;\n    line-height: 1.5 !important;\n  }\n\n  /* ── LOADING ── */\n  #gate-loading { display: none !important; text-align: center !important; padding: 24px 0 !important; }\n  #gate-loading.active { display: block !important; }\n  #gate-loading-text {\n    font-size: 0.95rem !important;\n    font-weight: 700 !important;\n    color: #1a1a1a !important;\n    margin-top: 20px !important;\n    line-height: 1.7 !important;\n  }\n\n  /* ── STUCK HINT ── */\n  #gate-stuck-hint {\n    display: none !important;\n    margin-top: 16px !important;\n    padding: 12px 14px !important;\n    background: #fbf6ee !important;\n    border: 1px solid #e8d6bb !important;\n    border-radius: 8px !important;\n    font-size: 0.78rem !important;\n    font-weight: 600 !important;\n    color: #6d4620 !important;\n    text-align: center !important;\n    line-height: 1.5 !important;\n  }\n  #gate-stuck-hint.visible { display: block !important; }\n\n  /* ── SPINNER ── */\n  .gate-spinner {\n    width: 56px !important;\n    height: 56px !important;\n    border: 5px solid #ebe7df !important;\n    border-top-color: #8a5a2b !important;\n    border-radius: 50% !important;\n    animation: gate-spin 0.9s linear infinite !important;\n    margin: 0 auto !important;\n  }\n  @keyframes gate-spin { to { transform: rotate(360deg); } }\n\n  /* ── SMALL PHONES ── */\n  @media (max-width: 480px) {\n    #reward-gate-modal { width: 95vw !important; padding: 22px 14px 26px !important; max-height: 92vh !important; }\n    #reward-gate-modal .gate-question { font-size: 1.05rem !important; }\n    #reward-gate-modal .gate-btn { font-size: 0.85rem !important; padding: 14px 12px !important; }\