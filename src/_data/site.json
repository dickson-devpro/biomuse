adEvt = e;\n      if (wantsAd && armed && !done) { try { adEvt.makeRewardedVisible(); } catch (err) { finish(); } }\n    });\n    googletag.pubads().addEventListener('rewardedSlotGranted', finish);\n    googletag.pubads().addEventListener('rewardedSlotClosed', finish);\n    googletag.display(r);\n  });\n\n  /* Step 1 -> 2, progress bar */\n  overlay.querySelectorAll('[data-next]').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      overlay.querySelectorAll('.gate-step').forEach(function (s) { s.classList.remove('active'); });\n      var target = document.getElementById('gate-step-unlock');\n      if (target) target.classList.add('active');\n      var fill = document.getElementById('gate-progress-bar-fill');\n      var pct = parseInt(btn.getAttribute('data-pct'), 10) || 100;\n      if (fill) fill.style.setProperty('width', pct + '%', 'important');\n      if (typeof window.gtag === 'function') window.gtag('event', 'gate_step1');\n    });\n  });\n\n  /* Watch ad */\n  var trigger = overlay.querySelector('[data-trigger=\"reward\"]');\n  if (trigger) {\n    trigger.addEventListener('click', function () {\n      if (done) return;\n      wantsAd = true;\n      if (typeof window.gtag === 'function') window.gtag('event', 'gate_ad_start');\n      overlay.querySelectorAll('.gate-step').forEach(function (s) { s.classList.remove('active'); });\n      var loading = document.getElementById('gate-loading');\n      if (loading) loading.classList.add('active');\n\n      hintTimer = setTimeout(function () {\n        var hint = document.getElementById('gate-stuck-hint');\n        if (hint) hint.classList.add('visible');\n      }, HINT_MS);\n\n      fallbackTimer = setTimeout(finish, FALLBACK_MS);\n\n      setTimeout(function () {\n        armed = true;\n        if (adEvt && !done) { try { adEvt.makeRewardedVisible(); } catch (e) { finish(); } }\n      }, PREROLL_MS);\n    });\n  }\n\n  function finish() {\n    if (done) return;\n    done = true;\n    if (fallbackTimer) clearTimeout(fallbackTimer);\n    if (hintTimer) clearTimeout(hintTimer);\n    setUnlocked();\n    if (typeof window.gtag === 'function') window.gtag('event', 'gate_unlocked');\n    if (overlay) overlay.remove();\n    document.documentElement.classList.remove('gate-pending');\n    document.body.classList.remove('gate-active');\n    document.body.classList.add('content-unlocked');\n    document.body.style.overflow = '';\n    loadOutOfPage({ anchor: true });\n  }\n})();\n</script>"
