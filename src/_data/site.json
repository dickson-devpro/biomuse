===== */\n\n  #gate-loading {\n\n    display: none !important;\n\n    text-align: center !important;\n\n    padding: 24px 4px !important;\n  }\n\n\n  #gate-loading.active {\n    display: block !important;\n  }\n\n\n  #gate-loading-text {\n\n    font-size: 0.95rem !important;\n\n    font-weight: 700 !important;\n\n    color: #1f2937 !important;\n\n    margin-top: 20px !important;\n\n    line-height: 1.7 !important;\n  }\n\n\n  /* =========================================================\n     STUCK HINT\n     ========================================================= */\n\n  #gate-stuck-hint {\n\n    display: none !important;\n\n    margin-top: 16px !important;\n\n    padding: 12px 14px !important;\n\n    background: #f0fdf4 !important;\n\n    border: 1px solid #bbf7d0 !important;\n\n    border-radius: 10px !important;\n\n    font-size: 0.78rem !important;\n\n    font-weight: 600 !important;\n\n    color: #166534 !important;\n\n    text-align: center !important;\n\n    line-height: 1.5 !important;\n  }\n\n\n  #gate-stuck-hint.visible {\n    display: block !important;\n  }\n\n\n  /* =========================================================\n     GREEN SPINNER\n     ========================================================= */\n\n  .gate-spinner {\n\n    width: 52px !important;\n\n    height: 52px !important;\n\n    border: 5px solid #dcfce7 !important;\n\n    border-top-color: #16a34a !important;\n\n    border-radius: 50% !important;\n\n    animation:\n      gate-spin 0.9s linear infinite !important;\n\n    margin: 0 auto !important;\n  }\n\n\n  @keyframes gate-spin {\n\n    to {\n      transform: rotate(360deg);\n    }\n\n  }\n\n\n  /* =========================================================\n     MOBILE — TABLETS\n     ========================================================= */\n\n  @media (max-width: 768px) {\n\n    #reward-gate-overlay {\n\n      padding:\n        max(14px, env(safe-area-inset-top))\n        max(14px, env(safe-area-inset-right))\n        max(14px, env(safe-area-inset-bottom))\n        max(14px, env(safe-area-inset-left)) !important;\n\n    }\n\n    #reward-gate-modal {\n\n      width: min(94vw, 460px) !important;\n\n      max-height:\n        calc(100dvh - 28px) !important;\n\n      padding: 28px 20px 26px !important;\n\n      border-radius: 17px !important;\n\n    }\n\n  }\n\n\n  /* =========================================================\n     MOBILE — SMALL PHONES\n     ========================================================= */\n\n  @media (max-width: 480px) {\n\n    #reward-gate-overlay {\n\n      align-items: center !important;\n\n      padding:\n        max(12px, env(safe-area-inset-top))\n        max(12px, env(safe-area-inset-right))\n        max(12px, env(safe-area-inset-bottom))\n        max(12px, env(safe-area-inset-left)) !important;\n    }\n\n\n    #reward-gate-modal {\n\n      width: 94vw !important;\n\n      max-width: 420px !important;\n\n      max-height:\n        calc(100dvh - 24px) !important;\n\n      padding:\n        25px 17px 24px !important;\n\n      border-radius: 16px !important;\n\n      overflow-y: auto !important;\n    }\n\n\n    .gate-step-label {\n\n      font-size: 0.66rem !important;\n\n      margin-bottom: 14px !important;\n    }\n\n\n    #reward-gate-modal .gate-question {\n\n      font-size: 1.08rem !important;\n\n      line-height: 1.35 !important;\n\n      margin-bottom: 8px !important;\n    }\n\n\n    #reward-gate-modal .gate-subtext {\n\n      font-size: 0.86rem !important;\n\n      line-height: 1.5 !important;\n\n      margin-bottom: 17px !important;\n    }\n\n\n    #reward-gate-modal .gate-btn {\n\n      min-height: 52px !important;\n\n      padding: 15px 12px !important;\n\n      font-size: 0.84rem !important;\n\n      border-radius: 11px !important;\n    }\n\n\n    #gate-unlock-title {\n\n      font-size: 1.12rem !important;\n\n      margin-top: 6px !important;\n    }\n\n\n    #gate-unlock-sub {\n\n      font-size: 0.87rem !important;\n\n      margin-bottom: 13px