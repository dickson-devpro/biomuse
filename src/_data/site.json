 display: none !important;\n      content: none !important;\n    }\n\n    body.gate-active {\n      overflow: auto !important;\n    }\n\n  }\n\n</style>\n\n\n<div id=\"reward-gate-overlay\" style=\"display:none;\">\n\n  <div id=\"reward-gate-modal\">\n\n    <!-- PROGRESS BAR -->\n\n    <div id=\"gate-progress-bar-bg\">\n      <div id=\"gate-progress-bar-fill\"></div>\n    </div>\n\n\n    <!-- STEP 1 OF 2 -->\n\n    <div\n      class=\"gate-step active\"\n      id=\"gate-step-1\"\n    >\n\n      <span class=\"gate-step-label\">\n        Step 1 of 2\n      </span>\n\n      <p class=\"gate-question\">\n        Are you ready to access this grant or support?\n      </p>\n\n      <p class=\"gate-subtext\">\n        This guide is free to access. Tap below to continue.\n      </p>\n\n      <button\n        class=\"gate-btn\"\n        data-next=\"unlock\"\n        data-pct=\"100\"\n      >\n        Yes, Continue →\n      </button>\n\n    </div>\n\n\n    <!-- STEP 2 OF 2 -->\n\n    <div\n      class=\"gate-step\"\n      id=\"gate-step-unlock\"\n    >\n\n      <span class=\"gate-step-label\">\n        Step 2 of 2\n      </span>\n\n      <p id=\"gate-unlock-title\">\n        ✅ Your Guide Is Ready\n      </p>\n\n      <p id=\"gate-unlock-sub\">\n        Watch a short ad to unlock full access.\n      </p>\n\n      <p id=\"gate-ad-disclaimer\">\n        You may be shown a short ad before access unlocks.\n        This helps keep it free.\n      </p>\n\n      <button\n        id=\"gate-view-btn\"\n        data-trigger=\"reward\"\n      >\n        CONTINUE\n      </button>\n\n      <p id=\"gate-ad-note\">\n        ⏱ Takes only 5–10 seconds. No sign-up needed.\n      </p>\n\n    </div>\n\n\n    <!-- LOADING SCREEN -->\n\n    <div id=\"gate-loading\">\n\n      <div class=\"gate-spinner\"></div>\n\n      <p id=\"gate-loading-text\">\n        Great choice! We're preparing<br>\n        your guide…<br>\n        unlocking now.\n      </p>\n\n      <div id=\"gate-stuck-hint\">\n        Ad finished but stuck? Try tapping the small\n        'X' or 'Close' at the top corner of your screen\n        to access the guide.\n      </div>\n\n    </div>\n\n  </div>\n\n</div>\n\n\n<script>\n(function () {\n\n  /* =========================================================\n     BIOMUSE GATE + OUT-OF-PAGE ENGINE\n     ========================================================= */\n\n  var UNITS = {\n\n    anchor:\n      '/23055182665/enter.biomuse.com.ng/Anchor',\n\n    interstitial:\n      '/23055182665/enter.biomuse.com.ng/Interstitial',\n\n    rewarded:\n      '/23055182665/enter.biomuse.com.ng/rewarded'\n\n  };\n\n\n  var LOCK_KEY =\n    'content_unlocked';\n\n\n  var LOCK_MS =\n    24 * 60 * 60 * 1000;\n\n\n  var PREROLL_MS =\n    3500;\n\n\n  var FALLBACK_MS =\n    15000;\n\n\n  var HINT_MS =\n    10000;\n\n\n  window.googletag =\n    window.googletag || {\n      cmd: []\n    };\n\n\n  /* =========================================================\n     PREVENT DUPLICATE GATES\n     ========================================================= */\n\n  var dupes =\n    document.querySelectorAll(\n      '#reward-gate-overlay'\n    );\n\n\n  for (\n    var k = 1;\n    k < dupes.length;\n    k++\n  ) {\n\n    dupes[k].remove();\n\n  }\n\n\n  if (window._gateInitialised) {\n    return;\n  }\n\n\n  window._gateInitialised = true;\n\n\n  /* =========================================================\n     UNLOCK CHECK\n     ========================================================= */\n\n  function isUnlocked() {\n\n    try {\n\n      var d =\n        JSON.parse(\n          localStorage.getItem(\n            LOCK_KEY\n          )\n        );\n\n      return !!d &&\n        (Date.now() - d.time) <\n        LOCK_MS;\n\n    } catch (e) {\n\n      return false;\n\n    }\n\n  }\n\n\n  /* =========================================================\n     SET UNLOCK\n     ========================================================= */\n\n  function setUnlocked() {\n\n    try {\n\n      localStorage.setItem(\n\n        LOCK_KEY,\n\n        JSON.stringify({\n          time: Date.now()\n        })\n\n      );\n\n    } catch (e) {}\n\n  }\n\n\n  /* =========================================================\n     PAGE TYPE\n     ========================================================= */\n\n  var isPost =\n    document.body.classList.contains(\n      'single-post'\n    ) ||\n    document.body.classList.contains(\n      'single'\n    );\n\n\n  var isMobile =\n    window.innerWidth <= 768;\n\n\n  var overlay =\n    document.getElementById(\n      'reward-gate-overlay'\n    );\n\n\n  /* =========================================================\n     PRE-PAINT GUARD\n     ========================================================= */\n\n  if (\n    isMobile &&\n    isPost &&\n    !isUnlocked()\n  ) {\n\n    document.documentElement.classList.add(\n      'gate-pending'\n    );\n\n  }\n\n\n  setTimeout(\n    function () {\n\n      document.documentElement.classList.remove(\n        'gate-pending'\n      );\n\n    },\n    4000\n  );\n\n\n  /* =========================================================\n     OUT-OF-PAGE ADS\n     ========================================================= */\n\n  function loadOutOfPage(opts) {\n\n    googletag.cmd.push(\n      function () {\n\n        if (opts.anchor) {\n\n          var a =\n            googletag.defineOutOfPageSlot(\n\n              UNITS.anchor,\n\n              googletag.enums\n                .OutOfPageFormat\n                .TOP_ANCHOR\n\n            );\n\n\n          if (a) {\n\n            a.addService(\n              googletag.pubads()\n            );\n\n            googletag.display(a);\n\n          }\n\n        }\n\n\n        if (\n          opts.interstitial &&\n          !window._bmInterstitial\n        ) {\n\n          window._bmInterstitial =\n            true;\n\n\n          var i =\n            googletag.defineOutOfPageSlot(\n\n              UNITS.interstitial,\n\n              googletag.enums\n                .OutOfPageFormat\n                .INTERSTITIAL\n\n            );\n\n\n          if (i) {\n\n            i.addService(\n              googletag.pubads()\n            );\n\n            googletag.display(i);\n\n          }\n\n        }\n\n      }\n    );\n\n  }\n\n\n  /* =========================================================\n     NOT AN ARTICLE\n     ========================================================= */\n\n  if (!isPost) {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n\n    if (overlay) {\n      overlay.remove();\n    }\n\n\n    return;\n\n  }\n\n\n  /* =========================================================\n     DESKTOP / ALREADY UNLOCKED\n     ========================================================= */\n\n  if (\n    !isMobile ||\n    isUnlocked()\n  ) {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n\n    if (overlay) {\n      overlay.remove();\n    }\n\n\n    document.body.classList.remove(\n      'gate-active'\n    );\n\n\n    if (isUnlocked()) {\n\n      document.body.classList.add(\n        'content-unlocked'\n      );\n\n    }\n\n\n    loadOutOfPage({\n\n      anchor: true,\n\n      interstitial: true\n\n    });\n\n\n    return;\n\n  }\n\n\n  /* =========================================================\n     SAFETY FALLBACK\n     ========================================================= */\n\n  if (!overlay) {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n\n    loadOutOfPage({\n\n      anchor: true,\n\n      interstitial: true\n\n    });\n\n\n    return;\n\n  }\n\n\n  /* =========================================================\n     SHOW GATE\n     ========================================================= */\n\n  document.body.classList.remove(\n    'content-unlocked'\n  );\n\n\n  document.body.classList.add(\n    'gate-active'\n  );\n\n\n  overlay.style.display =\n    'flex';\n\n\n  document.body.appendChild(\n    overlay\n  );\n\n\n  document.documentElement.classList.remove(\n    'gate-pending'\n  );\n\n\n  /* Interstitial runs alongside gate */\n\n  loadOutOfPage({\n\n    interstitial: true\n\n  });\n\n\n  var adEvt = null;\n\n  var wantsAd = false;\n\n  var armed = false;\n\n  var done = false;\n\n  var fallbackTimer = null;\n\n  var hintTimer = null;\n\n\n  /* =========================================================\n     REWARDED AD\n     ========================================================= */\n\n  googletag.cmd.push(\n    function () {\n\n      var r =\n        googletag.defineOutOfPageSlot(\n\n          UNITS.rewarded,\n\n          googletag.enums\n            .OutOfPageFormat\n            .REWARDED\n\n        );\n\n\n      if (!r) {\n        return;\n      }\n\n\n      r.addService(\n        googletag.pubads()\n      );\n\n\n      googletag.pubads()\n        .addEventListener(\n\n          'rewardedSlotReady',\n\n          function (e) {\n\n            adEvt = e;\n\n\n            if (\n              wantsAd &&\n              armed &&\n              !done\n            ) {\n\n              try {\n\n                adEvt\n                  .makeRewardedVisible();\n\n              } catch (err) {\n\n                finish();\n\n              }\n\n            }\n\n          }\n\n        );\n\n\n      googletag.pubads()\n        .addEventListener(\n\n          'rewardedSlotGranted',\n\n          finish\n\n        );\n\n\n      googletag.pubads()\n        .addEventListener(\n\n          'rewardedSlotClosed',\n\n          finish\n\n        );\n\n\n      googletag.display(r);\n\n    }\n  );\n\n\n  /* =========================================================\n     STEP 1 → STEP 2\n     ========================================================= */\n\n  overlay\n    .querySelectorAll(\n      '[data-next]'\n    )\n    .forEach(\n      function (btn) {\n\n        btn.addEventListener(\n          'click',\n          function () {\n\n            overlay\n              .querySelectorAll(\n                '.gate-step'\n              )\n              .forEach(\n                function (s) {\n\n                  s.classList.remove(\n                    'active'\n                  );\n\n                }\n              );\n\n\n            var target =\n              document.getElementById(\n                'gate-step-unlock'\n              );\n\n\n            if (target) {\n\n              target.classList.add(\n                'active'\n              );\n\n            }\n\n\n            var fill =\n              document.getElementById(\n                'gate-progress-bar-fill'\n              );\n\n\n            var pct =\n              parseInt(\n                btn.getAttribute(\n                  'data-pct'\n                ),\n                10\n              ) || 100;\n\n\n            if (fill) {\n\n              fill.style.setProperty(\n                'width',\n                pct + '%',\n                'important'\n              );\n\n            }\n\n\n            if (\n              typeof window.gtag ===\n              'function'\n            ) {\n\n              window.gtag(\n                'event',\n                'gate_step1'\n              );\n\n            }\n\n          }\n        );\n\n      }\n    );\n\n\n  /* =========================================================\n     WATCH AD\n     ========================================================= */\n\n  var trigger =\n    overlay.querySelector(\n      '[data-trigger=\"reward\"]'\n    );\n\n\n  if (trigger) {\n\n    trigger.addEventListener(\n      'click',\n      function () {\n\n        if (done) {\n          return;\n        }\n\n\n        wantsAd = true;\n\n\n        if (\n          typeof window.gtag ===\n          'function'\n        ) {\n\n          window.gtag(\n            'event',\n            'gate_ad_start'\n          );\n\n        }\n\n\n        overlay\n          .querySelectorAll(\n            '.gate-step'\n          )\n          .forEach(\n            function (s) {\n\n              s.classList.remove(\n                'active'\n              );\n\n            }\n          );\n\n\n        var loading =\n          document.getElementById(\n            'gate-loading'\n          );\n\n\n        if (loading) {\n\n          loading.classList.add(\n            'active'\n          );\n\n        }\n\n\n        hintTimer =\n          setTimeout(\n            function () {\n\n              var hint =\n                document.getElementById(\n                  'gate-stuck-hint'\n                );\n\n\n              if (hint) {\n\n                hint.classList.add(\n                  'visible'\n                );\n\n              }\n\n            },\n            HINT_MS\n          );\n\n\n        fallbackTimer =\n          setTimeout(\n            finish,\n            FALLBACK_MS\n          );\n\n\n        setTimeout(\n          function () {\n\n            armed = true;\n\n\n            if (\n              adEvt &&\n              !done\n            ) {\n\n              try {\n\n                adEvt\n                  .makeRewardedVisible();\n\n              } catch (e) {\n\n                finish();\n\n              }\n\n            }\n\n          },\n          PREROLL_MS\n        );\n\n      }\n    );\n\n  }\n\n\n  /* =========================================================\n     FINISH / UNLOCK\n     ========================================================= */\n\n  function finish() {\n\n    if (done) {\n      return;\n    }\n\n\n    done = true;\n\n\n    if (fallbackTimer) {\n\n      clearTimeout(\n        fallbackTimer\n      );\n\n    }\n\n\n    if (hintTimer) {\n\n      clearTimeout(\n        hintTimer\n      );\n\n    }\n\n\n    setUnlocked();\n\n\n    if (\n      typeof window.gtag ===\n      'function'\n    ) {\n\n      window.gtag(\n        'event',\n        'gate_unlocked'\n      );\n\n    }\n\n\n    if (overlay) {\n\n      overlay.remove();\n\n    }\n\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n\n    document.body.classList.remove(\n      'gate-active'\n    );\n\n\n    document.body.classList.add(\n      'content-unlocked'\n    );\n\n\n    document.body.style.overflow =\n      '';\n\n\n    loadOutOfPage({\n\n      anchor: true\n\n    });\n\n  }\n\n})();\n</script>"
    }
