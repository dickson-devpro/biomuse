nter !important;\n    justify-content: center !important;\n\n    font-family:\n      -apple-system,\n      BlinkMacSystemFont,\n      \"Segoe UI\",\n      Roboto,\n      Arial,\n      sans-serif !important;\n\n    padding:\n      max(16px, env(safe-area-inset-top))\n      max(16px, env(safe-area-inset-right))\n      max(16px, env(safe-area-inset-bottom))\n      max(16px, env(safe-area-inset-left)) !important;\n\n    box-sizing: border-box !important;\n  }\n\n\n  /* =========================================================\n     MODAL\n     ========================================================= */\n\n  #reward-gate-modal {\n\n    background: #ffffff !important;\n\n    border-radius: 18px !important;\n\n    width: min(92vw, 480px) !important;\n\n    padding: 30px 22px 30px !important;\n\n    position: relative !important;\n\n    box-shadow:\n      0 18px 50px rgba(15, 23, 42, 0.24) !important;\n\n    max-height: min(92vh, 700px) !important;\n    max-height: min(92dvh, 700px) !important;\n\n    overflow-y: auto !important;\n    overflow-x: hidden !important;\n\n    box-sizing: border-box !important;\n\n    -webkit-overflow-scrolling: touch !important;\n\n    text-align: center !important;\n\n    overscroll-behavior: contain !important;\n  }\n\n\n  /* =========================================================\n     PROGRESS BAR\n     ========================================================= */\n\n  #gate-progress-bar-bg {\n\n    position: absolute !important;\n\n    top: 0 !important;\n    left: 0 !important;\n    right: 0 !important;\n\n    height: 5px !important;\n\n    background: #dcfce7 !important;\n\n    margin: 0 !important;\n    padding: 0 !important;\n\n    overflow: hidden !important;\n\n    border-radius: 18px 18px 0 0 !important;\n  }\n\n  #gate-progress-bar-fill {\n\n    height: 5px !important;\n\n    background: #16a34a !important;\n\n    transition:\n      width 0.4s ease !important;\n\n    width: 50% !important;\n\n    margin: 0 !important;\n    paddin