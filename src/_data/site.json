=\"gate-stuck-hint\">\n        Ad finished but stuck? Try tapping the small 'X' or 'Close' at the top corner of your screen to access the guide.\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function () {\n  /* ── Biomuse gate + out-of-page engine ──────────────────────────────── */\n  var UNITS = {\n    anchor:       '/23055182665/enter.biomuse.com.ng/Anchor',\n    interstitial: '/23055182665/enter.biomuse.com.ng/Interstitial',\n    rewarded:     '/23055182665/enter.biomuse.com.ng/rewarded'\n  };\n  var LOCK_KEY    = 'content_unlocked';\n  var LOCK_MS     = 24 * 60 * 60 * 1000;\n  var PREROLL_MS  = 3500;   /* loading screen before the ad fires */\n  var FALLBACK_MS = 15000;  /* no fill by now -> let them through */\n  var HINT_MS     = 10000;  /* \"stuck?\" hint appears */\n\n  window.googletag = window.googletag || { cmd: [] };\n\n  /* Only ever one gate on the page */\n  var dupes = document.querySelectorAll('#reward-gate-overlay');\n  for (var k = 1; k < dupes.length; k++) dupes[k].remove();\n  if (window._gateInitialised) return;\n  window._gateInitialised = true;\n\n  function isUnlocked() {\n    try {\n      var d = JSON.parse(localStorage.getItem(LOCK_KEY));\n      return !!d && (Date.now() - d.time) < LOCK_MS;\n    } catch (e) { return false; }\n  }\n  function setUnlocked() {\n    try { localStorage.setItem(LOCK_KEY, JSON.stringify({ time: Date.now() })); } catch (e) {}\n  }\n\n  var isPost   = document.body.classList.contains('single-post') || document.body.classList.contains('single');\n  var isMobile = window.innerWidth <= 768;\n  var overlay  = document.getElementById('reward-gate-overlay');\n\n  /* Pre-paint guard: hide the article before first paint on gated mobile views */\n  if (isMobile && isPost && !isUnlocked()) document.documentElement.classList.add('gate-pending');\n  setTimeout(function () { document.documentElement.classList.remove('gate-pending'); }, 4000);\n\n  function loadOutOfPage(opts) {\n    googletag.cmd.push(function (